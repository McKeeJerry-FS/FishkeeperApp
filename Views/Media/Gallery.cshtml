@using AquaHub.MVC.Models
@using AquaHub.MVC.Models.Enums
@model List<MediaItem>
@{
    ViewData["Title"] = "Media Gallery";
}

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-md-8">
            <h2><i class="bi bi-grid-3x3"></i> Media Gallery</h2>
        </div>
        <div class="col-md-4 text-end">
            <a asp-action="Index" class="btn btn-outline-secondary">List View</a>
            <a asp-action="Upload" class="btn btn-primary">Upload</a>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="row g-3">
            @foreach (var item in Model)
            {
                <div class="col-lg-2 col-md-3 col-sm-4 col-6">
                    <div class="position-relative">
                        <a asp-action="Details" asp-route-id="@item.Id">
                            @if (item.MediaType == MediaType.Image)
                            {
                                <img src="@item.FilePath" class="img-fluid rounded shadow-sm" alt="@item.Title"
                                     style="width: 100%; height: 200px; object-fit: cover;">
                            }
                            else
                            {
                                <div class="position-relative">
                                    <video src="@item.FilePath" class="img-fluid rounded shadow-sm"
                                           style="width: 100%; height: 200px; object-fit: cover;"></video>
                                    <div class="position-absolute top-50 start-50 translate-middle">
                                        <i class="bi bi-play-circle-fill text-white" style="font-size: 3rem; opacity: 0.8;"></i>
                                    </div>
                                </div>
                            }
                        </a>
                        @if (item.IsFavorite)
                        {
                            <span class="position-absolute top-0 end-0 m-2">
                                <i class="bi bi-star-fill text-warning"></i>
                            </span>
                        }
                    </div>
                    <p class="small text-center mt-1 mb-0">@item.Title</p>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <p>No media to display. <a asp-action="Upload">Upload your first media</a></p>
        </div>
    }
</div>