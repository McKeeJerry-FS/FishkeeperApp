@using AquaHub.MVC.Models
@using AquaHub.MVC.Models.Enums
@model MediaItem
@{
    ViewData["Title"] = "Media Details";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-8">
            <h2><i class="bi bi-info-circle"></i> Media Details</h2>
        </div>
        <div class="col-md-4 text-end">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                <i class="bi bi-pencil"></i> Edit
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-body text-center">
                    @if (Model.MediaType == MediaType.Image)
                    {
                        <img src="@Model.FilePath" class="img-fluid rounded shadow" alt="@Model.Title" style="max-height: 600px;">
                    }
                    else
                    {
                        <video src="@Model.FilePath" class="img-fluid rounded shadow" style="max-height: 600px; max-width: 100%;" controls>
                            Your browser does not support the video tag.
                        </video>
                    }
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="bi bi-card-text"></i> Description</h5>
                    </div>
                    <div class="card-body">
                        <p>@Model.Description</p>
                    </div>
                </div>
            }
        </div>

        <div class="col-lg-4">
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">@Model.Title</h5>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-5">Type:</dt>
                        <dd class="col-sm-7">
                            @if (Model.MediaType == MediaType.Image)
                            {
                                <span class="badge bg-info"><i class="bi bi-image"></i> Image</span>
                            }
                            else
                            {
                                <span class="badge bg-danger"><i class="bi bi-camera-video"></i> Video</span>
                            }
                        </dd>

                        <dt class="col-sm-5">Category:</dt>
                        <dd class="col-sm-7">
                            <span class="badge bg-secondary">@Model.Category</span>
                        </dd>

                        <dt class="col-sm-5">Uploaded:</dt>
                        <dd class="col-sm-7">@Model.UploadedAt.ToString("MMM dd, yyyy h:mm tt")</dd>

                        @if (Model.TakenAt.HasValue)
                        {
                            <dt class="col-sm-5">Taken:</dt>
                            <dd class="col-sm-7">@Model.TakenAt.Value.ToString("MMM dd, yyyy")</dd>
                        }

                        <dt class="col-sm-5">File Size:</dt>
                        <dd class="col-sm-7">@(Model.FileSize / 1024.0 / 1024.0).ToString("F2") MB</dd>

                        @if (Model.Width.HasValue && Model.Height.HasValue)
                        {
                            <dt class="col-sm-5">Dimensions:</dt>
                            <dd class="col-sm-7">@Model.Width × @Model.Height px</dd>
                        }

                        @if (Model.DurationSeconds.HasValue)
                        {
                            <dt class="col-sm-5">Duration:</dt>
                            <dd class="col-sm-7">
                                @{
                                    var duration = TimeSpan.FromSeconds(Model.DurationSeconds.Value);
                                    @($"{duration.Minutes}:{duration.Seconds:D2}")
                                }
                            </dd>
                        }

                        <dt class="col-sm-5">Views:</dt>
                        <dd class="col-sm-7">
                            <i class="bi bi-eye"></i> @Model.ViewCount
                        </dd>

                        <dt class="col-sm-5">Favorite:</dt>
                        <dd class="col-sm-7">
                            <button type="button" class="btn btn-sm btn-outline-warning" id="favoriteBtn" onclick="toggleFavorite(@Model.Id)">
                                <i class="bi bi-star@(Model.IsFavorite ? "-fill" : "")"></i>
                                <span id="favoriteText">@(Model.IsFavorite ? "Favorited" : "Add to Favorites")</span>
                            </button>
                        </dd>
                    </dl>
                </div>
            </div>

            @if (Model.Tank != null)
            {
                <div class="card mb-4">
                    <div class="card-header">
                        <h6 class="mb-0"><i class="bi bi-droplet"></i> Associated Tank</h6>
                    </div>
                    <div class="card-body">
                        <p class="mb-0">
                            <strong>@Model.Tank.Name</strong><br />
                            <small class="text-muted">@Model.Tank.VolumeGallons gallons</small>
                        </p>
                        <a asp-controller="Tank" asp-action="Dashboard" asp-route-id="@Model.Tank.Id" class="btn btn-sm btn-outline-primary mt-2">
                            View Tank
                        </a>
                    </div>
                </div>
            }

            @if (Model.JournalEntry != null)
            {
                <div class="card mb-4">
                    <div class="card-header">
                        <h6 class="mb-0"><i class="bi bi-journal-text"></i> Associated Journal Entry</h6>
                    </div>
                    <div class="card-body">
                        <p class="mb-0">
                            <strong>@Model.JournalEntry.Title</strong><br />
                            <small class="text-muted">@Model.JournalEntry.Timestamp.ToString("MMM dd, yyyy")</small>
                        </p>
                        <a asp-controller="Journal" asp-action="Details" asp-route-id="@Model.JournalEntry.Id" class="btn btn-sm btn-outline-primary mt-2">
                            View Entry
                        </a>
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.Tags))
            {
                <div class="card mb-4">
                    <div class="card-header">
                        <h6 class="mb-0"><i class="bi bi-tags"></i> Tags</h6>
                    </div>
                    <div class="card-body">
                        @foreach (var tag in Model.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                        {
                            <span class="badge bg-light text-dark me-1 mb-1">#@tag</span>
                        }
                    </div>
                </div>
            }

            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h6 class="mb-0"><i class="bi bi-trash"></i> Danger Zone</h6>
                </div>
                <div class="card-body">
                    <p class="small mb-2">Once you delete a media item, there is no going back. Please be certain.</p>
                    <form asp-action="Delete" method="post" onsubmit="return confirm('Are you sure you want to delete this media? This action cannot be undone.');">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-danger btn-sm w-100">
                            <i class="bi bi-trash"></i> Delete Media
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleFavorite(id) {
            fetch('/Media/ToggleFavorite/' + id, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': '@Html.AntiForgeryToken()'
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    const btn = document.getElementById('favoriteBtn');
                    const icon = btn.querySelector('i');
                    const text = document.getElementById('favoriteText');
                    
                    if (icon.classList.contains('bi-star-fill')) {
                        icon.classList.remove('bi-star-fill');
                        icon.classList.add('bi-star');
                        text.textContent = 'Add to Favorites';
                        btn.classList.remove('btn-warning');
                        btn.classList.add('btn-outline-warning');
                    } else {
                        icon.classList.remove('bi-star');
                        icon.classList.add('bi-star-fill');
                        text.textContent = 'Favorited';
                        btn.classList.remove('btn-outline-warning');
                        btn.classList.add('btn-warning');
                    }
                }
            })
            .catch(error => console.error('Error:', error));
        }
    </script>
}
