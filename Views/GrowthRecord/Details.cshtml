@model GrowthRecord

@{
    ViewData["Title"] = "Growth Record Details";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                    <h2 class="h4 mb-0">
                        <i class="bi bi-graph-up-arrow"></i> Growth Record Details
                    </h2>
                    <span class="badge bg-light text-dark">@Model.MeasurementDate.ToString("MMM dd, yyyy")</span>
                </div>
                <div class="card-body p-4">
                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <h6 class="text-muted">Livestock</h6>
                            <p class="fs-5 mb-0">@(Model.Livestock?.Name ?? Model.Livestock?.Species ?? "Livestock")</p>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-muted">Species</h6>
                            <p class="fs-5 mb-0">@(Model.Livestock?.Species ?? "Not provided")</p>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.PhotoPath))
                    {
                        <div class="mb-4">
                            <h5 class="text-muted mb-3">
                                <i class="bi bi-image"></i> Progress Image
                            </h5>
                            <img src="@Model.PhotoPath" alt="Growth record image" class="img-fluid rounded shadow-sm"
                                 style="max-height: 420px;" />
                        </div>
                    }

                    <div class="row g-3 mb-4">
                        <div class="col-md-3 col-6">
                            <div class="border rounded p-3 h-100 bg-light">
                                <div class="text-muted small">Length</div>
                                <div class="fw-semibold">@(Model.LengthInches.HasValue ?
                                                                        $"{Model.LengthInches.Value:F2}\"" : "-")</div>
                                </div>
                            </div>
                            <div class="col-md-3 col-6">
                                <div class="border rounded p-3 h-100 bg-light">
                                    <div class="text-muted small">Weight</div>
                                    <div class="fw-semibold">@(Model.WeightGrams.HasValue ? $"{Model.WeightGrams.Value:F1}                g" : "-")</div>
                                </div>
                            </div>
                            <div class="col-md-3 col-6">
                                <div class="border rounded p-3 h-100 bg-light">
                                    <div class="text-muted small">Diameter</div>
                                    <div class="fw-semibold">@(Model.DiameterInches.HasValue ?
                                                                            $"{Model.DiameterInches.Value:F2}\"" : "-")</div>
                                    </div>
                                </div>
                                <div class="col-md-3 col-6">
                                    <div class="border rounded p-3 h-100 bg-light">
                                        <div class="text-muted small">Height</div>
                                        <div class="fw-semibold">@(Model.HeightInches.HasValue ?
                                                                                $"{Model.HeightInches.Value:F2}\"" : "-")</div>
                                        </div>
                                    </div>
                                </div>

                                <div class="row g-4 mb-4">
                                    <div class="col-md-6">
                                        <h6 class="text-muted">Health Condition</h6>
                                        <p class="mb-0">@(string.IsNullOrEmpty(Model.HealthCondition) ? "Not provided" :
                                                                            Model.HealthCondition)</p>
                                        </div>
                                        <div class="col-md-6">
                                            <h6 class="text-muted">Color Quality</h6>
                                            <p class="mb-0">@(string.IsNullOrEmpty(Model.ColorVibrancy) ? "Not provided" :
                                                                                Model.ColorVibrancy)</p>
                                            </div>
                                        </div>

                                        <div class="mb-4">
                                            <h6 class="text-muted">Notes</h6>
                                            <div class="card bg-light border-0">
                                                <div class="card-body">
                                                    <p class="mb-0" style="white-space: pre-wrap;">@(string.IsNullOrWhiteSpace(Model.Notes)
                                                                                            ? "No notes recorded for this entry." : Model.Notes)</p>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="d-flex justify-content-between">
                                                <a asp-action="Index" asp-route-livestockId="@Model.LivestockId" class="btn btn-secondary">
                                                    <i class="bi bi-arrow-left"></i> Back to Records
                                                </a>
                                                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                                                    <i class="bi bi-pencil"></i> Edit Record
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>