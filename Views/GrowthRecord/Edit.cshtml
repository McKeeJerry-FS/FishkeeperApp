@model GrowthRecord

@{
    ViewData["Title"] = "Edit Growth Record";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-6">
            <i class="bi bi-pencil-square text-warning"></i> Edit Growth Record
        </h1>
        <a asp-action="Index" asp-route-livestockId="@Model.LivestockId" class="btn btn-outline-secondary">
            <i class="bi bi-x-circle"></i> Cancel
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0">Update Growth Record</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="LivestockId" />

                        <div class="mb-3">
                            <label class="form-label">
                                <i class="bi bi-fish"></i> Livestock
                            </label>
                            <input type="text" class="form-control"
                                   value="@(ViewBag.LivestockName ?? Model.Livestock?.Name ?? "Selected Livestock")"
                                   readonly />
                        </div>

                        <div class="mb-3">
                            <label asp-for="MeasurementDate" class="form-label">
                                <i class="bi bi-calendar-event"></i> Record Date <span class="text-danger">*</span>
                            </label>
                            <input asp-for="MeasurementDate" type="date" class="form-control" />
                            <span asp-validation-for="MeasurementDate" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="LengthInches" class="form-label">
                                    <i class="bi bi-rulers"></i> Length (inches)
                                </label>
                                <div class="input-group">
                                    <input asp-for="LengthInches" type="number" step="0.01" class="form-control"
                                           placeholder="0.00" />
                                    <span class="input-group-text">"</span>
                                </div>
                                <span asp-validation-for="LengthInches" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="WeightGrams" class="form-label">
                                    <i class="bi bi-scale"></i> Weight (grams)
                                </label>
                                <div class="input-group">
                                    <input asp-for="WeightGrams" type="number" step="0.1" class="form-control"
                                           placeholder="0.0" />
                                    <span class="input-group-text">g</span>
                                </div>
                                <span asp-validation-for="WeightGrams" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="DiameterInches" class="form-label">
                                    <i class="bi bi-circle"></i> Diameter (inches)
                                </label>
                                <div class="input-group">
                                    <input asp-for="DiameterInches" type="number" step="0.01" class="form-control"
                                           placeholder="0.00" />
                                    <span class="input-group-text">"</span>
                                </div>
                                <span asp-validation-for="DiameterInches" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="HeightInches" class="form-label">
                                    <i class="bi bi-arrows-vertical"></i> Height (inches)
                                </label>
                                <div class="input-group">
                                    <input asp-for="HeightInches" type="number" step="0.01" class="form-control"
                                           placeholder="0.00" />
                                    <span class="input-group-text">"</span>
                                </div>
                                <span asp-validation-for="HeightInches" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="HealthCondition" class="form-label">
                                    <i class="bi bi-heart-pulse"></i> Health Condition
                                </label>
                                <select asp-for="HealthCondition" class="form-select">
                                    <option value="">-- Select Condition --</option>
                                    <option value="Excellent">Excellent</option>
                                    <option value="Good">Good</option>
                                    <option value="Fair">Fair</option>
                                    <option value="Poor">Poor</option>
                                </select>
                                <span asp-validation-for="HealthCondition" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="ColorVibrancy" class="form-label">
                                    <i class="bi bi-palette"></i> Color Quality
                                </label>
                                <select asp-for="ColorVibrancy" class="form-select">
                                    <option value="">-- Select Quality --</option>
                                    <option value="Vibrant">Vibrant</option>
                                    <option value="Normal">Normal</option>
                                    <option value="Faded">Faded</option>
                                    <option value="Dull">Dull</option>
                                </select>
                                <span asp-validation-for="ColorVibrancy" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Notes" class="form-label">
                                <i class="bi bi-chat-left-text"></i> Notes
                            </label>
                            <textarea asp-for="Notes" class="form-control" rows="4"
                                      placeholder="Observations, behavior, feeding, etc..."></textarea>
                            <span asp-validation-for="Notes" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label">
                                <i class="bi bi-image"></i> Progress Image
                            </label>
                            @if (!string.IsNullOrEmpty(Model.PhotoPath))
                            {
                                <div class="card mb-3">
                                    <div class="card-body">
                                        <label class="form-label">Current image</label>
                                        <img src="@Model.PhotoPath" alt="Current growth record image"
                                             class="img-fluid rounded shadow-sm" style="max-height: 260px;" />
                                    </div>
                                </div>
                            }
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label for="imageFile" class="form-label">Choose replacement image</label>
                                    <input type="file" name="ImageFile" id="imageFile" accept="image/*"
                                           class="form-control" />
                                    <div class="form-text">Select a new image from your device.</div>
                                </div>
                                <div class="col-md-6">
                                    <label for="cameraImageFile" class="form-label">Take replacement photo</label>
                                    <input type="file" name="CameraImageFile" id="cameraImageFile" accept="image/*"
                                           capture="environment" class="form-control" />
                                    <div class="form-text">Uses the device camera when available.</div>
                                </div>
                            </div>
                            <div id="imagePreviewContainer" class="card mt-3 d-none">
                                <div class="card-body">
                                    <label class="form-label">New image preview</label>
                                    <img id="imagePreview" alt="New image preview" class="img-fluid rounded shadow-sm"
                                         style="max-height: 280px;" />
                                    <div id="imagePreviewText" class="form-text mt-2"></div>
                                </div>
                            </div>
                            <div class="form-text mt-2">Leave both inputs empty to keep the current image.</div>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                                <i class="bi bi-eye"></i> Details
                            </a>
                            <button type="submit" class="btn btn-warning">
                                <i class="bi bi-save"></i> Update Record
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/image-input-preview.js" asp-append-version="true"></script>
    <script>
        initializeImageInputPreview({
        uploadInputId: 'imageFile',
        cameraInputId: 'cameraImageFile',
        previewContainerId: 'imagePreviewContainer',
        previewImageId: 'imagePreview',
        previewTextId: 'imagePreviewText'
        });
    </script>
}